# ===== 오프라인 서버용 환경변수 =====
# 로컬 Supabase (서버 PC에서 Docker로 실행)
# supabase start 하면 화면에 URL과 key가 표시됨 — 그걸 여기에 붙여넣으세요.

NEXT_PUBLIC_SUPABASE_URL=http://172.16.62.64:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_key_붙여넣기
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_붙여넣기

# 카카오 공유 — 오프라인에선 사용 안 함
NEXT_PUBLIC_KAKAO_APP_KEY=
