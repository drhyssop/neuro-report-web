# Supabase (https://supabase.com/dashboard/project/_/settings/api 에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ⚠️ Service Role Key — 절대 클라이언트 노출 금지. 관리자 계정 생성/삭제용.
# Vercel 배포 시 Environment Variables에 입력하되 "Sensitive" 체크.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 카카오 공유 (선택사항 — 미설정 시 Web Share API로 폴백)
# https://developers.kakao.com 에서 앱 생성 후 JavaScript 키 복사
# 플랫폼 → Web → 사이트 도메인에 배포 URL 추가 필수
NEXT_PUBLIC_KAKAO_APP_KEY=
